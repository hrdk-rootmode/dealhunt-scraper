# ═══════════════════════════════════════════════
# DEALHUNT V3.0 ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dealhunt

# Redis (Railway Redis)
REDIS_URL=redis://default:password@host:6379

# AI (Groq API)
GROQ_API_KEY=gsk_your_groq_api_key_here

# GitHub Auto-Backup
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO=your-username/dealhunt-scraper
GITHUB_BRANCH=main

# Environment
NODE_ENV=development
PORT=3000

# Scraping Config
USE_BROWSER=false
SCRAPE_DELAY=2000
SEED_LIMIT=50

# Cron Security (Optional)
CRON_SECRET=your_secret_key_here

# Data Retention
DATA_RETENTION_MONTHS=6