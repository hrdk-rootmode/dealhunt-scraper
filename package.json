{
  "name": "dealhunt-scraper",
  "version": "3.0.0",
  "description": "Commercial Price Comparison Platform with Subscriptions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm install",
    "reset": "node reset.js",
    "sync": "node src/scripts/sync-platforms.js",
    "seed": "node src/scripts/seed.js",
    "ai": "node src/scripts/process-ai.js",
    "daily": "node src/scripts/daily-automation.js",
    "backup": "node src/scripts/github-backup.js",
    "cleanup": "node src/scripts/monthly-cleanup.js",
    "alerts": "node src/scripts/check-alerts.js",
    "setup": "npm run reset && npm run sync"
  },
  "keywords": [
    "scraper",
    "price-comparison",
    "self-healing",
    "ai",
    "e-commerce",
    "subscription"
  ],
  "author": "DealHunt",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^11.11.0",
    "node-cron": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "p-limit": "^7.2.0",
    "p-retry": "^7.1.1",
    "pg": "^8.11.3",
    "puppeteer": "^21.5.0",
    "razorpay": "^2.9.2",
    "redis": "^4.6.10",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "puppeteer": {
    "skipDownload": true
  }
